# Secret de signature des cookies de session (min. 32 caractères aléatoires)
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<random-hex-32-chars>

# GlitchTip (compatible Sentry) — remontée d'erreurs. DSN fourni dans les
# paramètres du projet GlitchTip. Le DSN est public (visible côté client).
NUXT_PUBLIC_SENTRY_DSN=https://<clé>@<hôte-glitchtip>/<id-projet>
NUXT_PUBLIC_SENTRY_ENVIRONMENT=development
